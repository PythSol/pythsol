---
/*
 * Override of Starlight's default ThemeSelect: an icon-only button that
 * cycles auto → light → dark (auto = follow the OS, the default). It
 * reuses Starlight's "starlight-theme" localStorage key so the stock
 * ThemeProvider inline script still paints the right theme at load.
 */
const labels: Record<string, string> = {
    auto: "Theme: system (click for light)",
    light: "Theme: light (click for dark)",
    dark: "Theme: dark (click for system)",
};
---

<button
    class="ps-theme"
    id="ps-theme"
    type="button"
    data-starlight-theme="auto"
    aria-label={labels.auto}
>
    <span class="i i-auto" set:html={'<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"/><path d="M12 4v16" stroke="currentColor" stroke-width="1.6"/><path d="M12 4a8 8 0 0 1 0 16" fill="currentColor"/></svg>'} />
    <span class="i i-light" set:html={'<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="4.4" stroke="currentColor" stroke-width="1.6"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5 5l1.6 1.6M17.4 17.4L19 19M19 5l-1.6 1.6M6.6 17.4L5 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'} />
    <span class="i i-dark" set:html={'<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>'} />
</button>

<script>
    const button = document.querySelector<HTMLButtonElement>("#ps-theme");
    const html = document.documentElement;
    const labels: Record<string, string> = {
        auto: "Theme: system (click for light)",
        light: "Theme: light (click for dark)",
        dark: "Theme: dark (click for system)",
    };
    const order = ["auto", "light", "dark"] as const;
    type Mode = (typeof order)[number];

    function effective(mode: Mode): "light" | "dark" {
        if (mode === "auto") {
            return window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
        }
        return mode;
    }

    function paint(mode: Mode): void {
        if (!button) return;
        html.dataset.theme = effective(mode);
        button.dataset.starlightTheme = mode;
        button.setAttribute("aria-label", labels[mode]);
    }

    const stored = localStorage.getItem("starlight-theme");
    paint(order.includes(stored as Mode) ? (stored as Mode) : "auto");

    button?.addEventListener("click", () => {
        const current = (button.dataset.starlightTheme ?? "auto") as Mode;
        const next = order[(order.indexOf(current) + 1) % order.length];
        localStorage.setItem("starlight-theme", next);
        paint(next);
    });
</script>

<style>
    .ps-theme {
        width: 2rem;
        height: 2rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: none;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
    }
    .ps-theme:hover {
        color: var(--sl-color-text-accent);
    }
    .ps-theme .i {
        display: none;
        width: 1.25rem;
        height: 1.25rem;
    }
    .ps-theme[data-starlight-theme="auto"] .i-auto,
    .ps-theme[data-starlight-theme="light"] .i-light,
    .ps-theme[data-starlight-theme="dark"] .i-dark {
        display: inline-flex;
    }
    .ps-theme svg {
        width: 100%;
        height: 100%;
    }
</style>
