---
/*
 * Override of Starlight's default SiteTitle: the brand mark must match the
 * marketing site's navbar ("Pyth" in Python yellow, "Sol" in the Solana
 * mint→purple gradient) and click through to the landing page at "/".
 * The letterform mark reuses the favicon's P+S artwork (both cap height).
 */
---
<a href="/" class="site-title brandmark sl-flex" translate="no" aria-label="PythSol — home">
    <svg class="ps-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <defs>
            <linearGradient id="pythsol-ps-pg" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#ffd43b" />
                <stop offset="1" stop-color="#e8a20c" />
            </linearGradient>
            <linearGradient id="pythsol-ps-sg" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#14f195" />
                <stop offset="1" stop-color="#9945ff" />
            </linearGradient>
        </defs>
        <g
            font-family="'Segoe UI', Arial, 'Helvetica Neue', sans-serif"
            font-weight="900"
            font-size="24"
            stroke="#23262f"
            stroke-width="1.15"
            stroke-linejoin="round"
            paint-order="stroke"
        >
            <text x="1.8" y="24.1" textLength="14.6" lengthAdjust="spacingAndGlyphs" fill="url(#pythsol-ps-pg)">P</text>
            <text x="14.2" y="24.1" textLength="14.6" lengthAdjust="spacingAndGlyphs" fill="url(#pythsol-ps-sg)">S</text>
        </g>
    </svg>
    <span class="po">Pyth</span><span class="so">Sol</span>
</a>

<style>
    @layer starlight.core {
        .brandmark {
            font-size: 1.25rem;
            font-weight: 800;
            text-decoration: none;
            white-space: nowrap;
            min-width: 0;
            box-shadow: inset 0 -3px 0 var(--solana-mint);
            align-items: center;
        }
        .brandmark .ps-mark {
            width: 22px;
            height: 22px;
            margin-right: 7px;
            flex: none;
        }
        .brandmark .po {
            color: var(--accent, #ffd43b);
        }
        .brandmark .so {
            background: linear-gradient(90deg, var(--solana-mint, #14f195) 0%, var(--solana-purple, #9945ff) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
    }
</style>
