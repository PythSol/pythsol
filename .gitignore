# .gitignore for PythSol (Python + C toolchain artifacts)

# --- Python ---
__pycache__/
*.py[cod]
*.so
*.so.*
*.pyd
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/
uv.lock
# (uv.lock is generated but not committed until Phase 7: we build from source in CI.)

# --- Build outputs ---
target/
out/
graphify-out/
coverage.xml

# --- Web docs toolchain (Node) ---
node_modules/
web/**/dist/
web/**/.astro/
artifacts/
*.log

# Toolchain unpacked for local spikes is never committed.
Spikes/tools/

# --- OS ---
.DS_Store
Thumbs.db
